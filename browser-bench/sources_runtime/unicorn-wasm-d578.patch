     qemu/tcg/tcg-op-gvec.c
     qemu/tcg/tcg-op-vec.c
@@ -1550,3 +1556,4 @@ Cflags: -I\$\{includedir\}\n"
     )
     install(FILES ${CMAKE_BINARY_DIR}/unicorn.pc DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
 endif()
+
