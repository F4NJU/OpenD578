diff --git a/CMakeLists.txt b/CMakeLists.txt
index 033db09..00754ed 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -279,6 +279,11 @@ else()
                 set(UNICORN_TARGET_ARCH "loongarch64")
                 break()
             endif()
+            string(FIND "${UC_COMPILER_MACRO}" "__EMSCRIPTEN__" UC_RET)
+            if(${UC_RET} GREATER_EQUAL "0")
+                set(UNICORN_TARGET_ARCH "tci")
+                break()
+            endif()
             message(FATAL_ERROR "Unknown host compiler: ${CMAKE_C_COMPILER}.")
         endwhile(TRUE)
     endif()
@@ -503,6 +508,7 @@ set(UNICORN_ARCH_COMMON
 
     qemu/tcg/optimize.c
     qemu/tcg/tcg.c
