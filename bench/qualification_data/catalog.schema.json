{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenD578 qualification catalog",
  "type": "object",
  "required": ["schema_version", "target", "completeness", "sources", "features"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {"type": "string"},
    "completeness": {"const": "open_inventory_not_exhaustive"},
    "sources": {"type": "object"},
    "features": {"type": "array", "items": {
      "type": "object", "required": ["id", "group", "title", "scope", "model", "evidence", "acceptance", "automation", "blockers"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$"},
        "group": {"type": "string"}, "title": {"type": "string"},
        "scope": {"enum": ["oem_candidate", "extension", "later_stage"]},
        "model": {"enum": ["partial", "unimplemented"]},
        "automation": {"enum": ["partial_oem_only", "none"]},
        "acceptance": {"type": "string"}, "blockers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source", "level", "locator"]}}
      }
    }}
  }
}
